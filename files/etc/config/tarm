config main 'main'
	option enabled '0'
	option interface 'awg0'
	option lan_device 'br-lan'
	option wan_interface 'wan'
	option dns_server ''
	option mark '0x700000'
	option socket_mark '0x800000'
	option table '700'
	option dnsmasq_section '@dnsmasq[0]'
